# Copy to .env and fill in — .env is gitignored (never commit real keys).

# --- PRIMARY: Nebius Token Factory (NVIDIA Nemotron, OpenAI-compatible) ---
NEBIUS_API_KEY=
# Optional overrides:
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEBIUS_MODEL_FAST=          # bulk inventory/scoring sweeps
# NEBIUS_MODEL_REASON=        # risk explanations (defaults to NEBIUS_MODEL)
# NEBIUS_MODEL_DEEP=          # cross-signal correlation

# --- FALLBACK: Amazon Bedrock (bearer token) ---
BEDROCK_API_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Uncomment to auto-confirm the human gate for demos/videos:
# SHIELD_NHI_NO_PROMPT=1